{
  "name": "fluxfast-react-browser-fixture",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "generate": "node generate-types.mjs",
    "check:generated": "node generate-types.mjs --check",
    "fluxfast:dev": "fluxfast-vite dev --config fluxfast.vite.config.mjs",
    "fluxfast:build": "fluxfast-vite build --config fluxfast.vite.config.mjs",
    "fluxfast:start": "fluxfast-vite start",
    "pretypecheck": "node generate-types.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test --config ../../adapter-conformance/playwright.config.ts",
    "test:e2e:distributed:production": "playwright test --config ../../adapter-conformance/playwright.distributed-react.config.ts"
  },
  "dependencies": {
    "@fluxfast/core": "workspace:*",
    "@fluxfast/devtools": "workspace:*",
    "@fluxfast/react": "workspace:*",
    "@fluxfast/vite": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "7.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "engines": { "node": "^22.12.0 || ^24.0.0" }
}
