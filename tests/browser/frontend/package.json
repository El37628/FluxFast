{
  "name": "fluxfast-browser-fixture",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "prebuild": "pnpm run generate",
    "build": "next build",
    "check:schema": "node ./generate-types.mjs --check-schema",
    "predev": "pnpm run generate",
    "dev": "next dev",
    "generate": "node ./generate-types.mjs",
    "start": "next start",
    "pretypecheck": "pnpm run generate",
    "typecheck": "next typegen && tsc --noEmit",
    "pretest:e2e": "pnpm run check:schema",
    "test:e2e": "playwright test --config ../../adapter-conformance/playwright.config.ts",
    "pretest:e2e:devtools": "pnpm run check:schema",
    "test:e2e:devtools": "playwright test --config playwright.devtools.config.ts",
    "pretest:e2e:distributed": "pnpm run check:schema",
    "test:e2e:distributed": "playwright test --config playwright.distributed.config.ts",
    "pretest:e2e:distributed:production": "node ./generate-types.mjs --check-schema --check-generated",
    "test:e2e:distributed:production": "playwright test --config playwright.production-distributed.config.ts",
    "pretest:e2e:production": "node ./generate-types.mjs --check-schema --check-generated",
    "test:e2e:production": "playwright test --config ../../adapter-conformance/playwright.config.ts"
  },
  "dependencies": {
    "@fluxfast/core": "workspace:*",
    "@fluxfast/devtools": "workspace:*",
    "@fluxfast/next": "workspace:*",
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  }
}
