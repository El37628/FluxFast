{
  "name": "fluxfast-browser-fixture",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "prebuild": "pnpm run generate",
    "build": "next build",
    "check:schema": "node ./generate-types.mjs --check-schema",
    "predev": "pnpm run generate",
    "dev": "next dev",
    "generate": "node ./generate-types.mjs",
    "start": "next start",
    "pretypecheck": "pnpm run generate",
    "typecheck": "next typegen && tsc --noEmit",
    "pretest:e2e": "pnpm run check:schema",
    "test:e2e": "playwright test",
    "pretest:e2e:distributed": "pnpm run check:schema",
    "test:e2e:distributed": "playwright test --config playwright.distributed.config.ts",
    "pretest:e2e:production": "pnpm run check:schema",
    "test:e2e:production": "playwright test e2e/live-flow.spec.ts --grep \"production build\""
  },
  "dependencies": {
    "@fluxfast/core": "workspace:*",
    "@fluxfast/next": "workspace:*",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  }
}
