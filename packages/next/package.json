{
  "name": "@fluxfast/next",
  "version": "0.8.0",
  "license": "MIT",
  "description": "Next.js App Router adapter for FluxFast",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/El37628/FluxFast.git",
    "directory": "packages/next"
  },
  "homepage": "https://github.com/El37628/FluxFast#readme",
  "bugs": {
    "url": "https://github.com/El37628/FluxFast/issues"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "bin",
    "dist"
  ],
  "bin": {
    "fluxfast": "bin/fluxfast.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/esm/client.js",
      "require": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./generate": {
      "types": "./dist/generate.d.ts",
      "import": "./dist/esm/generate.js",
      "require": "./dist/generate.js",
      "default": "./dist/generate.js"
    },
    "./next-config": {
      "types": "./dist/next-config.d.ts",
      "import": "./dist/esm/next-config.js",
      "require": "./dist/next-config.js",
      "default": "./dist/next-config.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json && node ../../scripts/write-esm-package.mjs dist/esm",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fluxfast/core": "^0.8.0"
  },
  "peerDependencies": {
    "next": ">=16.3.0 <17.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "happy-dom": "^20.13.0",
    "next": "^16.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
