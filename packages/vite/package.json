{
  "name": "@fluxfast/vite",
  "version": "1.2.0",
  "license": "MIT",
  "description": "Same-origin React SSR host and Vite tooling for FluxFast",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/El37628/FluxFast.git",
    "directory": "packages/vite"
  },
  "homepage": "https://github.com/El37628/FluxFast#readme",
  "bugs": {
    "url": "https://github.com/El37628/FluxFast/issues"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "bin",
    "dist"
  ],
  "bin": {
    "fluxfast-vite": "bin/fluxfast-vite.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/esm/server.js",
      "require": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json && node ../../scripts/write-esm-package.mjs dist/esm",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fluxfast/codegen": "^1.2.0",
    "@fluxfast/core": "^1.2.0",
    "@fluxfast/react": "^1.2.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "vite": ">=7.3.6 <8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "7.3.6",
    "vitest": "^4.1.11"
  }
}
