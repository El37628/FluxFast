{
  "name": "@fluxfast/core",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Framework-neutral core client runtime for FluxFast",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/El37628/FluxFast.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/El37628/FluxFast#readme",
  "bugs": {
    "url": "https://github.com/El37628/FluxFast/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
