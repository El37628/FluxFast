{
  "name": "@fluxfast/core",
  "version": "0.7.0",
  "license": "MIT",
  "description": "Framework-neutral core client runtime for FluxFast",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/El37628/FluxFast.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/El37628/FluxFast#readme",
  "bugs": {
    "url": "https://github.com/El37628/FluxFast/issues"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./dist/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json && node ../../scripts/write-esm-package.mjs dist/esm",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
